#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import rospy
import numpy as np
import serial
import time
import threading
from geometry_msgs.msg import PointStamped, PoseStamped
import moveit_commander
from tf.transformations import quaternion_from_euler, quaternion_matrix
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

# =========================================================
# CONFIGURATION
# =========================================================
GRIPPER_PORT = "/dev/ttyACM0"
GRIPPER_BAUD = 9600
TACTILE_PORT = "/dev/ttyACM1"
TACTILE_BAUD = 250000

FORCE_THRESHOLD = 1.0
STABLE_SAMPLE_DELAY = 2.0

# Gripper Hex Commands
CLOSE_CMD = 'AA 55 00 01 01 01 01 08 FF 03 E9 01 20 01 3D'
OPEN_CMD  = 'AA 55 00 01 01 01 01 05 FF 03 FF 01 2F 02 2A'
THUMB_OPEN_CMD  = 'AA 55 01 00 00 00 00 05 FF 03 FF 00 9F 02 9A'
THUMB_CLOSE_CMD = 'AA 55 01 00 00 00 00 08 FF 05 96 00 90 01 F4'

# =========================================================
# TACTILE & VISUALIZATION ENGINE
# =========================================================

class TactileSystem:
    def __init__(self, port, baud):
        self.lock = threading.Lock()
        self.current_forces = np.zeros(12)
        self.history_x = [[] for _ in range(3)]
        self.history_y = [[] for _ in range(3)]
        
        # Sensor Geometry
        self.rc = 4.0 
        self.theta = np.deg2rad([0, 90, 180, 270])
        self.xs = self.rc * np.cos(self.theta)
        self.ys = self.rc * np.sin(self.theta)

        try:
            self.ser = serial.Serial(port, baud, timeout=0.1)
            rospy.loginfo("[Tactile] Serial Connected.")
        except:
            rospy.logerr("[Tactile] Connection Failed.")
            self.ser = None

        # Start background reading thread
        self.running = True
        self.thread = threading.Thread(target=self._update_loop)
        self.thread.daemon = True
        self.thread.start()

    def _update_loop(self):
        while self.running and not rospy.is_shutdown():
            if self.ser and self.ser.in_waiting > 0:
                line = self.ser.readline().decode(errors="ignore").strip()
                vals = line.split(",")
                if len(vals) == 12:
                    try:
                        with self.lock:
                            self.current_forces = np.array(vals, dtype=float)
                    except ValueError:
                        pass

    def get_forces(self):
        with self.lock:
            return self.current_forces.copy()

    def reset_history(self):
        with self.lock:
            self.history_x = [[] for _ in range(3)]
            self.history_y = [[] for _ in range(3)]

# =========================================================
# ROBOT CONTROL
# =========================================================

class ApplePicker:
    def __init__(self):
        rospy.init_node("apple_grasp_tactile_integrated")
        
        # MoveIt
        moveit_commander.roscpp_initialize([])
        self.group = moveit_commander.MoveGroupCommander("manipulator")
        
        # Hardware
        self.gripper_ser = serial.Serial(GRIPPER_PORT, GRIPPER_BAUD, timeout=1)
        self.tactile = TactileSystem(TACTILE_PORT, TACTILE_BAUD)
        
        # State
        self.latest_point = None
        self.last_processed_stamp = None
        rospy.Subscriber("/detected_point_base", PointStamped, self.target_callback)

    def target_callback(self, msg):
        self.latest_point = msg

    def send_gripper(self, cmd):
        self.gripper_ser.write(bytearray.fromhex(cmd))
        time.sleep(0.1)

    def perform_grasp_sequence(self):
        if self.latest_point is None or self.latest_point.header.stamp == self.last_processed_stamp:
            return

        target = self.latest_point
        self.last_processed_stamp = target.header.stamp
        self.tactile.reset_history()

        # 1. Approach
        rospy.loginfo("Moving to Approach...")
        pose_app = self.create_pose(target, offset_front=-0.20, offset_lr=-0.08)
        if not self.move_to(pose_app): return

        # 2. Target
        rospy.loginfo("Moving to Target...")
        pose_target = self.create_pose(target, offset_front=0.025, offset_lr=0.015)
        if not self.move_to(pose_target): return

        # 3. Grasp
        rospy.loginfo("Grasping...")
        self.send_gripper(CLOSE_CMD)
        time.sleep(0.2)
        self.send_gripper(THUMB_CLOSE_CMD)
        rospy.sleep(STABLE_SAMPLE_DELAY)

        # 4. Evaluate
        forces = self.tactile.get_forces()
        is_good = self.compute_quality(forces)
        rospy.loginfo(f"Grasp Quality: {'GOOD' if is_good else 'BAD'}")

        # 5. Retreat & Decision
        self.move_to(pose_app)
        if is_good:
            self.place_object()
        else:
            self.send_gripper(OPEN_CMD)
            self.send_gripper(THUMB_OPEN_CMD)
        
        self.return_home()

    def create_pose(self, point_msg, offset_front=0.0, offset_lr=0.0, offset_tool=-0.1):
        q = quaternion_from_euler(0, np.pi/2, 0)
        T = quaternion_matrix(q)
        offset = T @ np.array([0.0, offset_lr, offset_tool, 1.0])
        
        pose = PoseStamped()
        pose.header.frame_id = "base"
        pose.pose.orientation.x, pose.pose.orientation.y, pose.pose.orientation.z, pose.pose.orientation.w = q
        pose.pose.position.x = point_msg.point.x + offset[0] + offset_front
        pose.pose.position.y = point_msg.point.y + offset[1]
        pose.pose.position.z = point_msg.point.z + offset[2]
        return pose

    def move_to(self, pose):
        self.group.set_pose_target(pose)
        return self.group.go(wait=True)

    def compute_quality(self, forces):
        good_fingers = 0
        for f in range(3):
            seg = forces[f*4 : (f+1)*4]
            if np.sum(seg) > FORCE_THRESHOLD:
                # COP logic matches your visualization script
                xcop = np.sum(seg * self.tactile.xs) / np.sum(seg)
                ycop = np.sum(seg * self.tactile.ys) / np.sum(seg)
                if np.sqrt(xcop**2 + ycop**2) < 1.5:
                    good_fingers += 1
        return good_fingers >= 2

    def place_object(self):
        # Your specific place coordinates
        p = PoseStamped()
        p.header.frame_id = "base"
        q = quaternion_from_euler(0, np.pi/2, 0)
        p.pose.orientation.x, p.pose.orientation.y, p.pose.orientation.z, p.pose.orientation.w = q
        p.pose.position.x, p.pose.position.y, p.pose.position.z = 0.65, 0.41, 0.22
        self.move_to(p)
        self.send_gripper(OPEN_CMD)
        self.send_gripper(THUMB_OPEN_CMD)

    def return_home(self):
        self.group.set_joint_value_target([0,0,0,0,0,0])
        self.group.go(wait=True)

# =========================================================
# MAIN EXECUTION WITH VISUALIZATION
# =========================================================

if __name__ == "__main__":
    picker = ApplePicker()

    # Setup Plotting
    fig, axs = plt.subplots(1, 3, figsize=(12, 4))
    names = ['Index', 'Middle', 'Ring']
    h_cops = []
    trajectories = []
    
    for i, ax in enumerate(axs):
        ax.set_xlim(-6, 6); ax.set_ylim(-6, 6); ax.set_aspect('equal')
        ax.set_title(names[i])
        # Draw sensor boundaries
        t = np.linspace(0, 2*np.pi, 100)
        ax.plot(5*np.cos(t), 5*np.sin(t), 'k--') 
        line, = ax.plot([], [], 'b-', alpha=0.6)
        scat = ax.scatter([], [], s=100, edgecolors='k')
        trajectories.append(line)
        h_cops.append(scat)

    def update_plot(frame):
        forces = picker.tactile.get_forces()
        for s in range(3):
            seg = forces[s*4 : (s+1)*4]
            f_sum = np.sum(seg)
            if f_sum > FORCE_THRESHOLD:
                x = np.sum(seg * picker.tactile.xs) / f_sum
                y = np.sum(seg * picker.tactile.ys) / f_sum
                
                picker.tactile.history_x[s].append(x)
                picker.tactile.history_y[s].append(y)
                
                h_cops[s].set_offsets([[x, y]])
                trajectories[s].set_data(picker.tactile.history_x[s], picker.tactile.history_y[s])
                
                # Color coding logic
                r = np.sqrt(x**2 + y**2)
                color = 'green' if r < 0.5 else 'yellow' if r < 1.5 else 'red'
                h_cops[s].set_facecolor(color)
        
        # Use plot update time to also check for robot commands
        if not rospy.is_shutdown():
            picker.perform_grasp_sequence()

    ani = FuncAnimation(fig, update_plot, interval=50)
    plt.tight_layout()
    plt.show()
