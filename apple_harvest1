# -*- coding: utf-8 -*-

import rospy
import numpy as np
import serial
import time
import threading
from geometry_msgs.msg import PointStamped, PoseStamped
import moveit_commander
from tf.transformations import quaternion_from_euler, quaternion_matrix
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

# =========================================================
# CONFIGURATION
# =========================================================
GRIPPER_PORT = "/dev/ttyACM0"
GRIPPER_BAUD = 9600
TACTILE_PORT = "/dev/ttyACM1"
TACTILE_BAUD = 250000

FORCE_THRESHOLD = 1.0
STABLE_SAMPLE_DELAY = 2.0
CHANNELS = 12

# Colors
COLOR_0 = (0, 0.7, 0)      # Green (Center)
COLOR_1 = (0.9, 0.7, 0)    # Yellow (Mid)
COLOR_2 = (0.9, 0, 0)      # Red (Edge)

# =========================================================
# TACTILE SYSTEM
# =========================================================

class TactileSystem:
    def __init__(self, port, baud):
        self.lock = threading.Lock()
        self.current_forces = np.zeros(CHANNELS)
        self.history_x = [[] for _ in range(3)]
        self.history_y = [[] for _ in range(3)]
        self.grasp_prediction = "IDLE"
        
        # Geometry
        self.Ro, self.Ri = 5.0, 2.0
        self.rc = (2/3) * (self.Ro**3 - self.Ri**3) / (self.Ro**2 - self.Ri**2)
        self.theta = np.deg2rad([0, 90, 180, 270])
        self.xs = self.rc * np.cos(self.theta)
        self.ys = self.rc * np.sin(self.theta)

        try:
            self.ser = serial.Serial(port, baud, timeout=0.1)
            rospy.loginfo("[Tactile] Serial Connected.")
        except Exception as e:
            rospy.logerr(f"[Tactile] Connection Failed: {e}")
            self.ser = None

        self.running = True
        self.thread = threading.Thread(target=self._update_loop)
        self.thread.daemon = True
        self.thread.start()

    def _update_loop(self):
        while self.running and not rospy.is_shutdown():
            if self.ser and self.ser.in_waiting > 0:
                line = self.ser.readline().decode(errors="ignore").strip()
                values = line.split(",")
                if len(values) >= CHANNELS + 1:
                    try:
                        floats = list(map(float, values[1:1 + CHANNELS]))
                        with self.lock:
                            self.current_forces = np.array(floats)
                    except ValueError:
                        pass

    def get_data(self):
        with self.lock:
            return self.current_forces.copy(), self.history_x, self.history_y, self.grasp_prediction

    def set_prediction(self, status):
        with self.lock:
            self.grasp_prediction = status

    def reset_history(self):
        with self.lock:
            self.history_x = [[] for _ in range(3)]
            self.history_y = [[] for _ in range(3)]
            self.grasp_prediction = "MONITORING"

# =========================================================
# ROBOT CONTROL WITH PREDICTION LOGIC
# =========================================================

class ApplePicker:
    def __init__(self, tactile_sys):
        rospy.init_node("apple_grasp_tactile_integrated")
        moveit_commander.roscpp_initialize([])
        self.group = moveit_commander.MoveGroupCommander("manipulator")
        self.tactile = tactile_sys
        
        try:
            self.gripper_ser = serial.Serial(GRIPPER_PORT, GRIPPER_BAUD, timeout=1)
        except:
            self.gripper_ser = None

        self.latest_point = None
        self.last_processed_stamp = None
        rospy.Subscriber("/detected_point_base", PointStamped, self.target_callback)

    def target_callback(self, msg):
        self.latest_point = msg

    def send_gripper(self, cmd):
        if self.gripper_ser:
            self.gripper_ser.write(bytearray.fromhex(cmd))
            time.sleep(0.1)

    def run_state_machine(self):
        if self.latest_point is None or self.latest_point.header.stamp == self.last_processed_stamp:
            return

        target = self.latest_point
        self.last_processed_stamp = target.header.stamp
        self.tactile.reset_history()

        # STEP 1: APPROACH
        p_app = self.create_pose(target, -0.20, -0.08)
        p_tar = self.create_pose(target, 0.025, 0.015)
        
        if self.move_to(p_app) and self.move_to(p_tar):
            # STEP 2: GRASP
            rospy.loginfo("Closing Gripper...")
            self.send_gripper('AA 55 00 01 01 01 01 08 FF 03 E9 01 20 01 3D')
            time.sleep(0.2)
            self.send_gripper('AA 55 01 00 00 00 00 08 FF 05 96 00 90 01 F4')
            
            # Allow sensors to stabilize
            rospy.sleep(STABLE_SAMPLE_DELAY)

            # STEP 3: GRASPING STATUS PREDICTION
            forces, _, _, _ = self.tactile.get_data()
            is_good = self.predict_status(forces)

            if is_good:
                self.tactile.set_prediction("STABLE GRASP - PROCEEDING")
                rospy.loginfo("[PREDICTION] Good Grasp. Detaching apple...")
                self.move_to(p_app) # Retreat with apple
                self.place()
            else:
                self.tactile.set_prediction("BAD GRASP - REGRIP REQUIRED")
                rospy.logwarn("[PREDICTION] Bad Grasp (COP too far). Releasing...")
                self.send_gripper('AA 55 00 01 01 01 01 05 FF 03 FF 01 2F 02 2A') # Release
            
            self.return_home()
            self.tactile.set_prediction("IDLE")

    def predict_status(self, forces):
        """
        Criterion: COP radius r must be < 1.5 on at least 2 fingers
        """
        good_fingers = 0
        for i in range(3):
            seg = forces[i*4:(i+1)*4]
            f_sum = np.sum(seg)
            if f_sum > FORCE_THRESHOLD:
                xc = np.sum(seg * self.tactile.xs) / f_sum
                yc = np.sum(seg * self.tactile.ys) / f_sum
                r = np.sqrt(xc**2 + yc**2)
                if r < 1.5:
                    good_fingers += 1
        
        return good_fingers >= 2

    def create_pose(self, point_msg, off_f, off_lr):
        q = quaternion_from_euler(0, np.pi/2, 0)
        T = quaternion_matrix(q)
        offset = T @ np.array([0.0, off_lr, -0.1, 1.0])
        p = PoseStamped()
        p.header.frame_id = "base"
        p.pose.orientation.x, p.pose.orientation.y, p.pose.orientation.z, p.pose.orientation.w = q
        p.pose.position.x = point_msg.point.x + offset[0] + off_f
        p.pose.position.y = point_msg.point.y + offset[1]
        p.pose.position.z = point_msg.point.z + offset[2]
        return p

    def move_to(self, pose):
        self.group.set_pose_target(pose)
        return self.group.go(wait=True)

    def place(self):
        p = PoseStamped()
        p.header.frame_id = "base"
        q = quaternion_from_euler(0, np.pi/2, 0)
        p.pose.orientation.x, p.pose.orientation.y, p.pose.orientation.z, p.pose.orientation.w = q
        p.pose.position.x, p.pose.position.y, p.pose.position.z = 0.65, 0.41, 0.22
        self.move_to(p)
        self.send_gripper('AA 55 00 01 01 01 01 05 FF 03 FF 01 2F 02 2A')

    def return_home(self):
        self.group.set_joint_value_target([0,0,0,0,0,0])
        self.group.go(wait=True)

# =========================================================
