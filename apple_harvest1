def update_viz(frame):
    forces, hx, hy, pred = tactile.get_data()
    status_text.set_text(f"Grasp Prediction: {pred}")
    
    # Set text color based on prediction
    if "STABLE" in pred: status_text.set_color('green')
    elif "BAD" in pred: status_text.set_color('red')
    else: status_text.set_color('blue')

    for s in range(3):
        seg = forces[s*4 : (s+1)*4]
        f_sum = np.sum(seg)
        if f_sum > FORCE_THRESHOLD:
            xc = np.sum(seg * tactile.xs) / f_sum
            yc = np.sum(seg * tactile.ys) / f_sum
            r = np.sqrt(xc**2 + yc**2)
            
            hx[s].append(xc); hy[s].append(yc)
            clr = COLOR_0 if r <= 0.5 else COLOR_1 if r <= 1.5 else COLOR_2
            
            h_cops[s].set_offsets([[xc, yc]])
            h_cops[s].set_facecolor(clr)
            trajectories[s].set_data(hx[s], hy[s])
            trajectories[s].set_color(clr)
            
    if not rospy.is_shutdown():
        # Using a thread to prevent the UI from freezing during MoveIt calls
        if not hasattr(update_viz, "robot_thread") or not update_viz.robot_thread.is_alive():
            update_viz.robot_thread = threading.Thread(target=picker.run_state_machine)
            update_viz.robot_thread.start()

ani = FuncAnimation(fig, update_viz, interval=50, cache_frame_data=False)
