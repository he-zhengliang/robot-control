#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import rospy
import serial
import time
import numpy as np
from threading import Lock

from geometry_msgs.msg import PointStamped, PoseStamped
import moveit_commander
from tf.transformations import quaternion_from_euler, quaternion_matrix

# =========================================================
# CONFIGURATION
# =========================================================

# -------- Serial ports --------
GRIPPER_PORT = "/dev/ttyACM0"
GRIPPER_BAUD = 9600

TACTILE_PORT = "/dev/ttyACM1"
TACTILE_BAUD = 250000

# -------- Timing --------
STABLE_SAMPLE_DELAY = 2.0     # seconds after grasp close
REGRASP_Z_OFFSET = -0.005     # 5 mm downward

# -------- Tactile --------
NUM_CHANNELS = 12
FORCE_THRESHOLD = 1.0

# -------- Gripper commands --------
CLOSE_CMD = 'AA 55 00 01 01 01 01 08 FF 03 E9 01 20 01 3D'
OPEN_CMD  = 'AA 55 00 01 01 01 01 05 FF 03 FF 01 2F 02 2A'
THUMB_OPEN_CMD  = 'AA 55 01 00 00 00 00 05 FF 03 FF 00 9F 02 9A'
THUMB_CLOSE_CMD = 'AA 55 01 00 00 00 00 08 FF 05 96 00 90 01 F4'

# =========================================================
# GLOBAL SHARED POINT
# =========================================================

latest_point = None
point_lock = Lock()

# =========================================================
# GRIPPER CONTROLLER
# =========================================================

class GripperController:
    def __init__(self, port, baud):
        try:
            self.ser = serial.Serial(port, baud, timeout=1)
            rospy.loginfo("[Gripper] Connected.")
        except serial.SerialException as e:
            rospy.logerr(f"[Gripper] Connection failed: {e}")
            self.ser = None

    def send_hex(self, cmd):
        if not self.ser:
            return
        self.ser.write(bytearray.fromhex(cmd))
        time.sleep(0.1)

    def close_hand(self):
        rospy.loginfo("[Gripper] Closing hand")
        self.send_hex(CLOSE_CMD)
        time.sleep(0.2)
        self.send_hex(THUMB_CLOSE_CMD)

    def open_hand(self):
        rospy.loginfo("[Gripper] Opening hand")
        self.send_hex(OPEN_CMD)
        time.sleep(0.2)
        self.send_hex(THUMB_OPEN_CMD)

# =========================================================
# TACTILE SENSOR INTERFACE
# =========================================================

class TactileReader:
    def __init__(self, port, baud):
        try:
            self.ser = serial.Serial(port, baud, timeout=1)
            rospy.loginfo("[Tactile] Connected.")
        except serial.SerialException as e:
            rospy.logerr(f"[Tactile] Connection failed: {e}")
            self.ser = None

    def read_one_sample(self):
        """
        Expected Arduino line format:
        c1,c2,c3,...,c12\n
        """
        if not self.ser:
            return None

        while True:
            line = self.ser.readline().decode(errors='ignore').strip()
            parts = line.split(',')
            if len(parts) == NUM_CHANNELS:
                try:
                    return np.array(parts, dtype=float)
                except ValueError:
                    continue

# =========================================================
# COP + GRASP QUALITY
# =========================================================

def compute_cop_and_class(forces):
    """
    forces: (12,) array
    return: list of 3 class labels
    """

    # Annulus geometry
    Ro, Ri = 5.0, 2.0
    rc = (2/3) * (Ro**3 - Ri**3) / (Ro**2 - Ri**2)

    # Electrode angles
    theta = np.deg2rad([180, 270, 0, 90])  # unit 1 at -x, unit 3 at +x
    xs = rc * np.cos(theta)
    ys = rc * np.sin(theta)

    classes = []

    for finger in range(3):
        seg = forces[finger*4:(finger+1)*4]
        fsum = np.sum(seg)

        if fsum < FORCE_THRESHOLD:
            classes.append(2)
            continue

        xcop = np.sum(seg * xs) / fsum
        ycop = np.sum(seg * ys) / fsum
        r = np.sqrt(xcop**2 + ycop**2)

        if r <= 0.5:
            classes.append(0)
        elif r <= 1.5:
            classes.append(1)
        else:
            classes.append(2)

    return classes

def grasp_is_good(classes):
    """
    At least 2 fingers are class 0 or 1
    """
    good = sum(c <= 1 for c in classes)
    return good >= 2

# =========================================================
# ROS CALLBACK
# =========================================================

def point_callback(msg):
    global latest_point
    with point_lock:
        latest_point = msg

# =========================================================
# MOTION HELPERS
# =========================================================

def create_pose(point, dz=0.0):
    q = quaternion_from_euler(0, np.pi/2, 0)
    pose = PoseStamped()
    pose.header.frame_id = "base"
    pose.pose.orientation.x = q[0]
    pose.pose.orientation.y = q[1]
    pose.pose.orientation.z = q[2]
    pose.pose.orientation.w = q[3]
    pose.pose.position.x = point.point.x
    pose.pose.position.y = point.point.y
    pose.pose.position.z = point.point.z + dz
    return pose

def move_to(group, pose):
    group.set_pose_target(pose)
    ok = group.go(wait=True)
    group.stop()
    group.clear_pose_targets()
    return ok

# =========================================================
# MAIN
# =========================================================

def main():
    rospy.init_node("apple_grasp_with_tactile")

    moveit_commander.roscpp_initialize([])
    group = moveit_commander.MoveGroupCommander("manipulator")

    gripper = GripperController(GRIPPER_PORT, GRIPPER_BAUD)
    tactile = TactileReader(TACTILE_PORT, TACTILE_BAUD)

    rospy.Subscriber("/detected_point_base", PointStamped, point_callback)

    rate = rospy.Rate(2)
    last_stamp = None

    while not rospy.is_shutdown():

        with point_lock:
            target = latest_point

        if target and target.header.stamp != last_stamp:
            last_stamp = target.header.stamp

            rospy.loginfo("[Main] Moving to target")
            pose = create_pose(target)
            if not move_to(group, pose):
                continue

            # ---------------- GRASP ----------------
            gripper.close_hand()
            rospy.sleep(STABLE_SAMPLE_DELAY)

            # -------- READ ONE STABLE SAMPLE --------
            forces = tactile.read_one_sample()
            if forces is None:
                rospy.logwarn("[Tactile] No data")
                gripper.open_hand()
                continue

            classes = compute_cop_and_class(forces)
            rospy.loginfo(f"[Tactile] Finger classes: {classes}")

            # -------- DECISION --------
            if grasp_is_good(classes):
                rospy.loginfo("[Decision] Good grasp → detach apple")
                # Detach / pull logic here
            else:
                rospy.logwarn("[Decision] Bad grasp → regrasp")
                gripper.open_hand()
                rospy.sleep(0.5)

                regrasp_pose = create_pose(target, dz=REGRASP_Z_OFFSET)
                move_to(group, regrasp_pose)

                gripper.close_hand()
                rospy.sleep(STABLE_SAMPLE_DELAY)

        rate.sleep()

if __name__ == "__main__":
    main()
