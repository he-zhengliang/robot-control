#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import rospy
import numpy as np
import serial
import time
from geometry_msgs.msg import PointStamped, PoseStamped
import moveit_commander
from tf.transformations import quaternion_from_euler, quaternion_matrix
from threading import Lock

# =========================================================
# CONFIG
# =========================================================

# -------- Serial --------
GRIPPER_PORT = "/dev/ttyACM0"
GRIPPER_BAUD = 9600

TACTILE_PORT = "/dev/ttyACM1"
TACTILE_BAUD = 250000

# -------- Timing --------
STABLE_SAMPLE_DELAY = 2.0   # seconds after close
FORCE_THRESHOLD = 1.0

# -------- Gripper commands --------
CLOSE_CMD = 'AA 55 00 01 01 01 01 08 FF 03 E9 01 20 01 3D'
OPEN_CMD  = 'AA 55 00 01 01 01 01 05 FF 03 FF 01 2F 02 2A'
THUMB_OPEN_CMD  = 'AA 55 01 00 00 00 00 05 FF 03 FF 00 9F 02 9A'
THUMB_CLOSE_CMD = 'AA 55 01 00 00 00 00 08 FF 05 96 00 90 01 F4'

# =========================================================
# SHARED TARGET POINT
# =========================================================

latest_point = None
point_lock = Lock()

# =========================================================
# GRIPPER
# =========================================================

class GripperController:
    def __init__(self, port, baud):
        try:
            self.ser = serial.Serial(port, baud, timeout=1)
            rospy.loginfo("[Gripper] Connected.")
        except serial.SerialException as e:
            rospy.logerr(e)
            self.ser = None

    def send_hex(self, cmd):
        if self.ser:
            self.ser.write(bytearray.fromhex(cmd))
            time.sleep(0.1)

    def close_hand(self):
        self.send_hex(CLOSE_CMD)
        time.sleep(0.2)
        self.send_hex(THUMB_CLOSE_CMD)

    def open_hand(self):
        self.send_hex(OPEN_CMD)
        time.sleep(0.2)
        self.send_hex(THUMB_OPEN_CMD)

# =========================================================
# TACTILE
# =========================================================

class TactileReader:
    def __init__(self, port, baud):
        try:
            self.ser = serial.Serial(port, baud, timeout=1)
            rospy.loginfo("[Tactile] Connected.")
        except serial.SerialException as e:
            rospy.logerr(e)
            self.ser = None

    def read_one_sample(self):
        if not self.ser:
            return None

        while True:
            line = self.ser.readline().decode(errors="ignore").strip()
            vals = line.split(",")
            if len(vals) == 12:
                try:
                    return np.array(vals, dtype=float)
                except ValueError:
                    pass

# =========================================================
# COP + QUALITY
# =========================================================

def compute_grasp_quality(forces):
    """
    forces: shape (12,)
    returns True if grasp is acceptable
    """

    # Geometry
    theta = np.deg2rad([180, 270, 0, 90])   # unit1=-x, unit3=+x
    rc = 4.0
    xs = rc * np.cos(theta)
    ys = rc * np.sin(theta)

    good_fingers = 0

    for f in range(3):
        seg = forces[f*4:(f+1)*4]
        fsum = np.sum(seg)

        if fsum < FORCE_THRESHOLD:
            continue

        xcop = np.sum(seg * xs) / fsum
        ycop = np.sum(seg * ys) / fsum
        r = np.sqrt(xcop**2 + ycop**2)

        if r < 1.5:
            good_fingers += 1

    return good_fingers >= 2

# =========================================================
# ROS CALLBACK
# =========================================================

def target_callback(msg):
    global latest_point
    with point_lock:
        latest_point = msg

# =========================================================
# MOTION HELPERS (UNCHANGED)
# =========================================================

def create_pose(point_msg, offset_front=0.0, offset_lr=0.0, offset_tool=-0.1):
    q = quaternion_from_euler(0, np.pi/2, 0)

    tool_offset = np.array([0.0, offset_lr, offset_tool, 1.0])
    T = quaternion_matrix(q)
    offset = T @ tool_offset

    pose = PoseStamped()
    pose.header.frame_id = "base"
    pose.pose.orientation.x = q[0]
    pose.pose.orientation.y = q[1]
    pose.pose.orientation.z = q[2]
    pose.pose.orientation.w = q[3]

    pose.pose.position.x = point_msg.point.x + offset[0] + offset_front
    pose.pose.position.y = point_msg.point.y + offset[1]
    pose.pose.position.z = point_msg.point.z + offset[2]
    return pose

def move_to_pose(group, pose):
    group.set_pose_target(pose)
    ok = group.go(wait=True)
    group.stop()
    group.clear_pose_targets()
    return ok

def return_home(group):
    home = [0, 0, 0, 0, 0, 0]
    group.set_joint_value_target(home)
    ok = group.go(wait=True)
    group.stop()
    return ok

# =========================================================
# MAIN
# =========================================================

def main():
    rospy.init_node("apple_grasp_with_tactile")

    moveit_commander.roscpp_initialize([])
    group = moveit_commander.MoveGroupCommander("manipulator")

    gripper = GripperController(GRIPPER_PORT, GRIPPER_BAUD)
    tactile = TactileReader(TACTILE_PORT, TACTILE_BAUD)

    rospy.Subscriber("/detected_point_base", PointStamped, target_callback)

    rate = rospy.Rate(2)
    last_stamp = None

    while not rospy.is_shutdown():

        with point_lock:
            target = latest_point

        if target and target.header.stamp != last_stamp:
            last_stamp = target.header.stamp

            # -------------------------------------------------
            # STEP 1: APPROACH
            approach_pose = create_pose(target, offset_front=-0.20, offset_lr=-0.08)
            if not move_to_pose(group, approach_pose):
                continue

            # -------------------------------------------------
            # STEP 2: TARGET
            target_pose = create_pose(target, offset_front=0.025, offset_lr=0.015)
            if not move_to_pose(group, target_pose):
                continue

            # -------------------------------------------------
            # STEP 3: GRASP
            gripper.close_hand()
            rospy.sleep(STABLE_SAMPLE_DELAY)

            forces = tactile.read_one_sample()
            if forces is None:
                rospy.logwarn("[Tactile] No data")
                gripper.open_hand()
                continue

            good = compute_grasp_quality(forces)
            rospy.loginfo(f"[Tactile] Grasp quality: {good}")

            # -------------------------------------------------
            # STEP 4: RETREAT
            move_to_pose(group, approach_pose)

            # -------------------------------------------------
            # STEP 5: PLACE OR REGRASP
            if good:
                rospy.loginfo("[Decision] Good grasp")

                place_pose = PoseStamped()
                place_pose.header.frame_id = "base"
                q = quaternion_from_euler(0, np.pi/2, 0)
                place_pose.pose.orientation.x = q[0]
                place_pose.pose.orientation.y = q[1]
                place_pose.pose.orientation.z = q[2]
                place_pose.pose.orientation.w = q[3]
                place_pose.pose.position.x = 0.65
                place_pose.pose.position.y = 0.41
                place_pose.pose.position.z = 0.22

                move_to_pose(group, place_pose)
                gripper.open_hand()

            else:
                rospy.logwarn("[Decision] Bad grasp → release")
                gripper.open_hand()

            # -------------------------------------------------
            # STEP 6: HOME
            return_home(group)
            rospy.sleep(2)

        rate.sleep()

if __name__ == "__main__":
    main()
