# =========================================================
# CONFIGURATION
# =========================================================
GRIPPER_PORT = "/dev/ttyACM0"
GRIPPER_BAUD = 9600
TACTILE_PORT = "/dev/ttyACM1"
TACTILE_BAUD = 250000

# Grasping Logic Thresholds
FORCE_THRESHOLD = 0.5       
MIN_GRASP_FORCE = 1.0       
STABLE_SAMPLE_DELAY = 2.0
CHANNELS = 12

# HEX COMMANDS
CMD_FINGERS_CLOSE = 'AA 55 00 01 01 01 01 08 FF 03 E9 01 20 01 3D' # Close 4 fingers
CMD_THUMB_CLOSE   = 'AA 55 01 00 00 00 00 08 FF 05 96 00 90 01 F4' # Close Thumb
CMD_OPEN_ALL      = 'AA 55 00 01 01 01 01 05 FF 03 FF 01 2F 02 2A' # Open all

# Mapping: 0-100 capacitance -> 0-3N Force
FORCE_CONVERSION = 3.0 / 100.0

# Colors for Visualization
COLOR_0 = (0, 0.7, 0)      # Green (Center)
COLOR_1 = (0.9, 0.7, 0)    # Yellow (Mid)
COLOR_2 = (0.9, 0, 0)      # Red (Edge)

# =========================================================
# TACTILE SYSTEM
# =========================================================

class TactileSystem:
    def __init__(self, port, baud):
        self.lock = threading.Lock()
        self.current_forces = np.zeros(CHANNELS)
        self.buffer = deque(maxlen=10) # <--- ADD THIS (holds last 10 samples)
        self.grasp_prediction = "IDLE"
        
        self.Ro, self.Ri = 5.0, 2.0
        self.rc = (2/3) * (self.Ro**3 - self.Ri**3) / (self.Ro**2 - self.Ri**2)
        
        self.theta = np.deg2rad([180, 90, 0, 270])
        self.xs = self.rc * np.cos(self.theta)
        self.ys = self.rc * np.sin(self.theta)

        try:
            self.ser = serial.Serial(port, baud, timeout=0.1)
            rospy.loginfo("[Tactile] Serial Connected.")
        except Exception as e:
            rospy.logerr(f"[Tactile] Connection Failed: {e}")
            self.ser = None

        self.running = True
        self.thread = threading.Thread(target=self._update_loop)
        self.thread.daemon = True
        self.thread.start()

    def _update_loop(self):
        while self.running and not rospy.is_shutdown():
            if self.ser and self.ser.in_waiting > 0:
                line = self.ser.readline().decode(errors="ignore").strip()
                values = line.split(",")
                if len(values) >= CHANNELS + 1:
                    try:
                        floats = [float(v) * FORCE_CONVERSION for v in values[1:1 + CHANNELS]]
                        with self.lock:
                            self.current_forces = np.array(floats)
                    except ValueError:
                        pass

    def get_data(self):
        with self.lock:
            return self.current_forces.copy(), self.grasp_prediction

    # ADD THIS NEW METHOD BELOW:
    def get_smoothed_data(self):
        with self.lock:
            if len(self.buffer) == 0:
                return self.current_forces.copy(), self.grasp_prediction
            return np.mean(self.buffer, axis=0), self.grasp_prediction

    def set_prediction(self, status):
        with self.lock:
            self.grasp_prediction = status

# =========================================================
# ROBOT CONTROL
# =========================================================

class ApplePicker:
    def __init__(self, tactile_sys):
        rospy.init_node("apple_grasp_tactile_integrated")
        moveit_commander.roscpp_initialize([])
        self.group = moveit_commander.MoveGroupCommander("manipulator")
        self.tactile = tactile_sys
        
        try:
            self.gripper_ser = serial.Serial(GRIPPER_PORT, GRIPPER_BAUD, timeout=1)
        except:
            self.gripper_ser = None

        self.latest_point = None
        self.last_processed_stamp = None
        rospy.Subscriber("/detected_point_base", PointStamped, self.target_callback)

    def target_callback(self, msg):
        self.latest_point = msg

    def send_gripper(self, cmd):
        if self.gripper_ser:
            self.gripper_ser.write(bytearray.fromhex(cmd))
            time.sleep(0.1)

    def run_state_machine(self):
        if self.latest_point is None or self.latest_point.header.stamp == self.last_processed_stamp:
            return

        target = self.latest_point
        self.last_processed_stamp = target.header.stamp
        self.tactile.set_prediction("MONITORING")

        # Pose Setup
        p_app = self.create_pose(target, -0.20, -0.08) # Pos 1 & 3
        p_tar = self.create_pose(target, 0.025, 0.015) # Pos 2

        # 1. Approach
        rospy.loginfo("Pos 1: Moving to Approach")
        if not self.move_to(p_app): return

        # 2. Target & Grasp
        rospy.loginfo("Pos 2: Moving to Target")
        if self.move_to(p_tar):
            # Combined Grasp: Fingers then Thumb
            self.send_gripper(CMD_FINGERS_CLOSE)
            time.sleep(0.2)
            self.send_gripper(CMD_THUMB_CLOSE)
            
            rospy.sleep(STABLE_SAMPLE_DELAY)

            # CHANGE THIS LINE:
            forces, _ = self.tactile.get_smoothed_data() # <--- Use smoothed data here
            
            if self.predict_status(forces):

            forces, _ = self.tactile.get_data()
            if self.predict_status(forces):

                self.tactile.set_prediction("STABLE - DETACHING")
                
                # 3. Detach (Retract back to Approach point)
                rospy.loginfo("Pos 3: Detaching")
                self.move_to(p_app) 

                # 4. Bucket
                rospy.loginfo("Pos 4: Moving to Bucket")
                self.move_to_bucket()
                self.send_gripper(CMD_OPEN_ALL)
                time.sleep(1.0)

                # 5. Transit
                rospy.loginfo("Pos 5: Moving to Transit")
                self.move_to_transit()
            else:
                # SAFETY RETRACTION
                self.tactile.set_prediction("BAD GRASP - RECOVERING")
                rospy.loginfo("Grasp failed. Releasing and retracting...")
                self.send_gripper(CMD_OPEN_ALL) 
                time.sleep(0.5)
                self.move_to(p_app) # Retreat to Pos 1
            
            # 6. Home
            rospy.loginfo("Pos 6: Returning Home")
            self.return_home()
            self.tactile.set_prediction("IDLE")

    def predict_status(self, forces):
        good_fingers = 0
        for i in range(3):
            seg = forces[i*4:(i+1)*4]
            f_sum = np.sum(seg)
            if f_sum >= MIN_GRASP_FORCE:
                xc = np.sum(seg * self.tactile.xs) / f_sum
                yc = np.sum(seg * self.tactile.ys) / f_sum
                r = np.sqrt(xc**2 + yc**2)
                if r < 1.5:
                    good_fingers += 1
        return good_fingers >= 2

    def create_pose(self, point_msg, off_f, off_lr):
        q = quaternion_from_euler(0, np.pi/2, 0)
        T = quaternion_matrix(q)
        offset = T @ np.array([0.0, off_lr, -0.1, 1.0])
        p = PoseStamped()
        p.header.frame_id = "base"
        p.pose.orientation.x, p.pose.orientation.y, p.pose.orientation.z, p.pose.orientation.w = q
        p.pose.position.x = point_msg.point.x + offset[0] + off_f
        p.pose.position.y = point_msg.point.y + offset[1]
        p.pose.position.z = point_msg.point.z + offset[2]
        return p

    def move_to(self, pose):
        self.group.set_pose_target(pose)
        return self.group.go(wait=True)

    def move_to_bucket(self):
        """Position 4: Fixed Bucket Pose"""
        p = PoseStamped()
        p.header.frame_id = "base"
        q = quaternion_from_euler(0, np.pi/2, 0)
        p.pose.orientation.x, p.pose.orientation.y, p.pose.orientation.z, p.pose.orientation.w = q
        p.pose.position.x, p.pose.position.y, p.pose.position.z = 0.65, 0.41, 0.22
        return self.move_to(p)

    def move_to_transit(self):
        """Position 5: Intermediate Transit Pose"""
        p = PoseStamped()
        p.header.frame_id = "base"
        q = quaternion_from_euler(0, np.pi/2, 0)
        p.pose.orientation.x, p.pose.orientation.y, p.pose.orientation.z, p.pose.orientation.w = q
        p.pose.position.x, p.pose.position.y, p.pose.position.z = 0.50, 0.09, 0.30
        return self.move_to(p)

    def return_home(self):
        """Position 6: Home Joint Configuration"""
        self.group.set_joint_value_target([0, 0, 0, 0, 0, 0])
        self.group.go(wait=True)

# =========================================================
# VISUALIZATION
# =========================================================

tactile = TactileSystem(TACTILE_PORT, TACTILE_BAUD)
picker = ApplePicker(tactile)

fig, axs = plt.subplots(1, 3, figsize=(15, 6), facecolor='white')
plt.subplots_adjust(bottom=0.25)
sensor_names = ['Index Finger', 'Middle Finger', 'Ring Finger']
h_cops, force_labels = [], []
circle_t = np.linspace(0, 2*np.pi, 200)

status_text = fig.text(0.5, 0.05, 'Status: IDLE', ha='center', fontsize=14, fontweight='bold', color='blue')

for i, ax in enumerate(axs):
    ax.set_xlim(-6, 6); ax.set_ylim(-6, 6); ax.set_aspect('equal')
    ax.plot(tactile.Ro*np.cos(circle_t), tactile.Ro*np.sin(circle_t), 'k', lw=1.5)
    ax.plot(tactile.Ri*np.cos(circle_t), tactile.Ri*np.sin(circle_t), 'k', lw=1.5)
    h_cops.append(ax.scatter([], [], s=200, edgecolors='black', zorder=5))
    force_labels.append(ax.text(0, -7.5, 'Force: 0.00N', ha='center', fontsize=12, fontweight='bold'))

def update_viz(frame):
    forces, pred = tactile.get_data()
    status_text.set_text(f"Grasp Prediction: {pred}")
    status_text.set_color('green' if "STABLE" in pred else 'red' if "BAD" in pred else 'blue')

    for s in range(3):
        f_sum = np.sum(forces[s*4 : (s+1)*4])
        force_labels[s].set_text(f"Force: {f_sum:.2f}N")
        force_labels[s].set_color('green' if f_sum >= MIN_GRASP_FORCE else 'red')
        if f_sum > 0.05:
            xc = np.sum(forces[s*4:(s+1)*4] * tactile.xs) / f_sum
            yc = np.sum(forces[s*4:(s+1)*4] * tactile.ys) / f_sum
            r = np.sqrt(xc**2 + yc**2)
            clr = COLOR_0 if r <= 0.8 else COLOR_1 if r <= 2.0 else COLOR_2
            h_cops[s].set_offsets([[xc, yc]])
            h_cops[s].set_facecolor(clr)
            h_cops[s].set_alpha(1.0)
        else: h_cops[s].set_alpha(0.0)
            
    if not rospy.is_shutdown():
        if not hasattr(update_viz, "robot_thread") or not update_viz.robot_thread.is_alive():
            update_viz.robot_thread = threading.Thread(target=picker.run_state_machine)
            update_viz.robot_thread.start()

ani = FuncAnimation(fig, update_viz, interval=50, cache_frame_data=False)
plt.show()
