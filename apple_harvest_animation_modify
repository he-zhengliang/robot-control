# =========================================================
# CONFIGURATION
# =========================================================
GRIPPER_PORT = "/dev/ttyACM0"
GRIPPER_BAUD = 9600
TACTILE_PORT = "/dev/ttyACM1"
TACTILE_BAUD = 250000

# Since values are normalized, 0.5 is a safe threshold to ignore noise
FORCE_THRESHOLD = 0.5  
TAIL_LENGTH = 25       # Length of the ghosting effect
CHANNELS = 12

# =========================================================
# TACTILE DATA ENGINE
# =========================================================

class TactileSystem:
    def __init__(self, port, baud):
        self.lock = threading.Lock()
        self.current_forces = np.zeros(CHANNELS)
        self.grasp_prediction = "IDLE"
        
        # Sensor Geometry
        self.Ro, self.Ri = 5.0, 2.0
        self.rc = (2/3) * (self.Ro**3 - self.Ri**3) / (self.Ro**2 - self.Ri**2)
        theta_deg = [0, 90, 180, 270]
        self.xs = self.rc * np.cos(np.deg2rad(theta_deg))
        self.ys = self.rc * np.sin(np.deg2rad(theta_deg))

        # Trajectory History
        self.history_x = [[] for _ in range(3)]
        self.history_y = [[] for _ in range(3)]

        try:
            self.ser = serial.Serial(port, baud, timeout=0.1)
            rospy.loginfo("[Tactile] Connected to Arduino.")
        except:
            self.ser = None
            rospy.logerr("[Tactile] Failed to connect.")

        self.thread = threading.Thread(target=self._update_loop)
        self.thread.daemon = True
        self.thread.start()

    def _update_loop(self):
        while not rospy.is_shutdown():
            if self.ser and self.ser.in_waiting > 0:
                line = self.ser.readline().decode(errors="ignore").strip()
                values = line.split(",")
                # Format: timestamp, c1, c2, ... c12
                if len(values) >= 13:
                    try:
                        # Extract ONLY the 12 normalized capacitance values
                        floats = [float(x) for x in values[1:13]]
                        with self.lock:
                            self.current_forces = np.array(floats)
                    except ValueError:
                        continue

    def get_data(self):
        with self.lock:
            return self.current_forces.copy(), self.history_x, self.history_y, self.grasp_prediction

# =========================================================
# ROBOT & VISUALIZATION LOGIC
# =========================================================

tactile = TactileSystem(TACTILE_PORT, TACTILE_BAUD)

fig, axs = plt.subplots(1, 3, figsize=(15, 5), facecolor='white')
sensor_names = ['Index Finger', 'Middle Finger', 'Ring Finger']
h_cops, h_tails = [], []
circle_t = np.linspace(0, 2*np.pi, 200)

for i, ax in enumerate(axs):
    ax.set_xlim(-6, 6); ax.set_ylim(-6, 6); ax.set_aspect('equal')
    # Draw Sensor Board Geometry
    ax.plot(tactile.Ro*np.cos(circle_t), tactile.Ro*np.sin(circle_t), 'k', lw=1.2)
    ax.plot(tactile.Ri*np.cos(circle_t), tactile.Ri*np.sin(circle_t), 'k', lw=1.2)
    ax.scatter(tactile.xs, tactile.ys, color='black', s=40, alpha=0.5)
    ax.set_title(sensor_names[i])
    
    # Visual Objects
    line, = ax.plot([], [], lw=2, alpha=0.6)
    dot = ax.scatter([0], [0], s=120, edgecolors='black', zorder=5) # Initial center dot
    h_tails.append(line)
    h_cops.append(dot)

def update(frame):
    forces, hx, hy, pred = tactile.get_data()
    
    for s in range(3):
        f_segment = forces[s*4 : (s+1)*4]
        f_sum = np.sum(f_segment)
        
        if f_sum > FORCE_THRESHOLD:
            # --- CONTACT STATE ---
            xc = np.sum(f_segment * tactile.xs) / f_sum
            yc = np.sum(f_segment * tactile.ys) / f_sum
            
            hx[s].append(xc)
            hy[s].append(yc)
            if len(hx[s]) > TAIL_LENGTH:
                hx[s].pop(0); hy[s].pop(0)
            
            h_tails[s].set_data(hx[s], hy[s])
            h_cops[s].set_offsets([[xc, yc]])
            
            # Color by quality (Radius < 1.5 is green)
            r = np.sqrt(xc**2 + yc**2)
            clr = (0, 0.7, 0) if r <= 1.5 else (0.9, 0, 0)
            h_cops[s].set_facecolor(clr)
            h_tails[s].set_color(clr)
            
        else:
            # --- IDLE STATE (CENTER ON ZERO) ---
            h_cops[s].set_offsets([[0, 0]])
            h_cops[s].set_facecolor((0.7, 0.7, 0.7)) # Neutral Gray
            
            # Clear history so no "old" trail lingers
            hx[s].clear()
            hy[s].clear()
            h_tails[s].set_data([], [])

    return h_cops + h_tails

