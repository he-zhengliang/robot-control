#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import rospy
import numpy as np
import serial
import time
import threading
from geometry_msgs.msg import PointStamped, PoseStamped
import moveit_commander
from tf.transformations import quaternion_from_euler, quaternion_matrix
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

# =========================================================
# CONFIGURATION
# =========================================================
GRIPPER_PORT = "/dev/ttyACM0"
GRIPPER_BAUD = 9600
TACTILE_PORT = "/dev/ttyACM1"
TACTILE_BAUD = 250000

FORCE_THRESHOLD = 0.5  # Sensitivity for COP calculation
CHANNELS = 12
TAIL_LENGTH = 30       # How many past points to show (the 'Ghost' tail)

# =========================================================
# TACTILE DATA ENGINE
# =========================================================

class TactileSystem:
    def __init__(self, port, baud):
        self.lock = threading.Lock()
        self.current_forces = np.zeros(CHANNELS)
        
        # Geometry setup
        self.Ro, self.Ri = 5.0, 2.0
        self.rc = (2/3) * (self.Ro**3 - self.Ri**3) / (self.Ro**2 - self.Ri**2)
        theta_deg = [0, 90, 180, 270]
        self.xs = self.rc * np.cos(np.deg2rad(theta_deg))
        self.ys = self.rc * np.sin(np.deg2rad(theta_deg))

        # Trajectory History
        self.history_x = [[] for _ in range(3)]
        self.history_y = [[] for _ in range(3)]

        try:
            self.ser = serial.Serial(port, baud, timeout=0.1)
            rospy.loginfo("[Tactile] Serial Connected.")
        except:
            self.ser = None
            rospy.logerr("[Tactile] Could not connect to Arduino.")

        self.thread = threading.Thread(target=self._update_loop)
        self.thread.daemon = True
        self.thread.start()

    def _update_loop(self):
        while not rospy.is_shutdown():
            if self.ser and self.ser.in_waiting > 0:
                line = self.ser.readline().decode(errors="ignore").strip()
                values = line.split(",")
                # Extraction: timestamp(0), c1(1)...c12(12)
                if len(values) >= 13:
                    try:
                        floats = [float(x) for x in values[1:13]]
                        with self.lock:
                            self.current_forces = np.array(floats)
                    except ValueError:
                        continue

    def get_data(self):
        with self.lock:
            return self.current_forces.copy()

# =========================================================
# VISUALIZATION SETUP
# =========================================================

tactile = TactileSystem(TACTILE_PORT, TACTILE_BAUD)

fig, axs = plt.subplots(1, 3, figsize=(15, 5), facecolor='white')
sensor_names = ['Index Finger', 'Middle Finger', 'Ring Finger']
h_cops = []      # The current COP dot
h_tails = []     # The fading trajectory line
circle_t = np.linspace(0, 2*np.pi, 200)

for i, ax in enumerate(axs):
    ax.set_xlim(-6, 6); ax.set_ylim(-6, 6); ax.set_aspect('equal')
    # Draw Board
    ax.plot(tactile.Ro*np.cos(circle_t), tactile.Ro*np.sin(circle_t), 'k', lw=1.5)
    ax.plot(tactile.Ri*np.cos(circle_t), tactile.Ri*np.sin(circle_t), 'k', lw=1.5)
    ax.scatter(tactile.xs, tactile.ys, color='black', s=60, zorder=3)
    ax.set_title(sensor_names[i])
    
    # Initial empty tail and dot
    tail_line, = ax.plot([], [], color='blue', alpha=0.4, lw=1.5, zorder=4)
    cop_dot = ax.scatter([], [], s=100, edgecolors='black', zorder=5)
    
    h_tails.append(tail_line)
    h_cops.append(cop_dot)

# =========================================================
# ANIMATION LOOP
# =========================================================

def update(frame):
    forces = tactile.get_data()
    
    for s in range(3):
        f_segment = forces[s*4 : (s+1)*4]
        f_sum = np.sum(f_segment)
        
        if f_sum > FORCE_THRESHOLD:
            # Calculate COP
            xc = np.sum(f_segment * tactile.xs) / f_sum
            yc = np.sum(f_segment * tactile.ys) / f_sum
            r = np.sqrt(xc**2 + yc**2)
            
            # Update history (The Rolling Window)
            tactile.history_x[s].append(xc)
            tactile.history_y[s].append(yc)
            
            # Keep only the last N points to create the "faded out" effect
            if len(tactile.history_x[s]) > TAIL_LENGTH:
                tactile.history_x[s].pop(0)
                tactile.history_y[s].pop(0)
            
            # Update Visuals
            h_tails[s].set_data(tactile.history_x[s], tactile.history_y[s])
            h_cops[s].set_offsets([[xc, yc]])
            
            # Color logic
            color = (0, 0.7, 0) if r <= 1.5 else (0.9, 0, 0)
            h_cops[s].set_facecolor(color)
            h_tails[s].set_color(color)
        else:
            # If no force, we can either clear the tail or leave it. 
            # Let's clear it slowly if no force is detected.
            if len(tactile.history_x[s]) > 0:
                tactile.history_x[s].pop(0)
                tactile.history_y[s].pop(0)
                h_tails[s].set_data(tactile.history_x[s], tactile.history_y[s])
            h_cops[s].set_offsets(np.empty((0, 2)))

    return h_cops + h_tails

ani = FuncAnimation(fig, update, interval=50, blit=True)
plt.tight_layout()
plt.show()
